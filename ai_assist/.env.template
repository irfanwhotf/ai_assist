# Gemini API key (required)
GEMINI_API_KEY=your_api_key_here

# User settings (optional)
USER_NAME=friend
# Set your name here for Neura to address you personally

# TTS settings (optional)
DEFAULT_VOICE=nova
DEFAULT_EMOTION=neutral
DEFAULT_SPEED=1.25

# STT settings (optional)
WHISPER_MODEL=small.en
# Options: tiny, tiny.en, base, base.en, small, small.en, medium, medium.en, large-v2, large-v3
# Smaller models are faster but less accurate
# Models with .en suffix are English-only and faster for English speech
